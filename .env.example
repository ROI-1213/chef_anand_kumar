# ========================================================
# Chef Anand Kumar Rebuild — Environment Variables
# ========================================================

# Server & Proxy Port Configuration (Strictly managed via .env)
PORT=3000
PROXY_PORT=3000
HOSTNAME=0.0.0.0

# Allowed Hosts / Origins (Comma-separated list to prevent blocked host errors)
ALLOWED_HOSTS=localhost,127.0.0.1,chefanandkumar.com,www.chefanandkumar.com,*.chefanandkumar.com

# Base Site URL
NEXT_PUBLIC_SITE_URL=https://www.chefanandkumar.com

# Contact Form Email Dispatch (Optional)
# Configure either Resend or custom SMTP credentials.
# If unconfigured, inquiries are securely logged on the server.
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=anand_hotel@yahoo.com

# Optional SMTP Provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=inquiries@chefanandkumar.com
